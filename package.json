{
  "name": "maiscestqui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "api": "wrangler dev --port 8788",
    "deploy": "npm run build && wrangler deploy",
    "db:init:local": "wrangler d1 migrations apply maiscestqui --local",
