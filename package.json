    "compte": "node scripts/creer-compte.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hono": "^4.6.3",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^4.0.0"
  }
}
